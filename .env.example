# Required
DATABASE_URL=postgres://...                  # Neon pooled connection string
AUTH_SECRET=                                  # openssl rand -base64 32
AUTH_GOOGLE_ID=                               # Google OAuth client ID
AUTH_GOOGLE_SECRET=                           # Google OAuth client secret
AUTH_URL=http://localhost:3000                # https://dinner-spinner-lake.vercel.app in prod
ALLOWED_EMAILS=you@example.com                # Comma-separated lowercased allowlist. Set to "*" to disable.
SEED_OWNER_EMAIL=you@example.com              # Email that owns pre-multi-user data. Used by backfill + bearer-token resolver.

# Optional
API_TOKEN=                                    # Long-lived bearer for curl scripts. Resolves to SEED_OWNER_EMAIL's user_id.
TODOIST_API_TOKEN=                            # Seed-owner Todoist fallback. Other users set theirs in /settings.
TODOIST_PROJECT_NAME=Shopping                 # Seed-owner Todoist fallback.

# Image generation & ingest (not part of auth)
#
# AI image generation — three paths, in precedence order:
#
# 1. GEMINI_API_KEY → Nano Banana Pro (Gemini 3 Pro Image) via Google's
#    Gemini API directly. ~22s/image, ~$0.139/image. Best quality at
#    named-dish recognition and long descriptive prompts.
#    Get a key at https://aistudio.google.com/apikey
#
# 2. REPLICATE_API_TOKEN → Flux 1.1 Pro via Replicate (auto-injected via
#    the Vercel marketplace integration). ~7s/image, ~$0.04/image. Good
#    fallback if Gemini is unavailable; quality is a notch below Nano
#    Banana Pro on regional dishes.
#
# 3. Generic HTTP fallback. If neither of the above is set but these two
#    are, POSTs to IMAGE_GEN_URL with a Bearer token. The endpoint must
#    return either raw image bytes (Content-Type: image/...) or JSON
#    with a { url } field.
#
# With none configured, image-gen calls surface a clear
# "not configured" error.
GEMINI_API_KEY=                               # Google AI Studio API key (preferred)
REPLICATE_API_TOKEN=                          # Replicate API token (auto-injected via Vercel marketplace)
IMAGE_GEN_URL=                                # Generic HTTP fallback for image generation
IMAGE_GEN_TOKEN=                              # Bearer token for IMAGE_GEN_URL

# Premium-model gating: Nano Banana Pro (path 1/2, ~$0.139/img) is reserved for
# the seed owner plus the emails listed here (comma-separated, lowercased; `*` =
# all users). Everyone else falls back to flux (~$0.04/img) on every image path.
# Empty/unset ⇒ seed owner only.
PREMIUM_IMAGE_EMAILS=                          # e.g. alice@example.com,bob@example.com

# Recipe ingestion via claude-agent on nex.
# Mint a token from the dashboard's "API Tokens" tab (scope: chat).
# Without it, /api/ingest returns 503 ingest_disabled.
NEX_API_TOKEN=                                # claude-agent API token for recipe ingestion
CLAUDE_AGENT_URL=https://nex.tail7f6b96.ts.net:10000  # claude-agent base URL (Tailscale Funnel endpoint)
