# Required
DATABASE_URL=postgres://...                  # Neon pooled connection string
AUTH_SECRET=                                  # openssl rand -base64 32
AUTH_GOOGLE_ID=                               # Google OAuth client ID
AUTH_GOOGLE_SECRET=                           # Google OAuth client secret
AUTH_URL=http://localhost:3000                # https://dinner-spinner-lake.vercel.app in prod
ALLOWED_EMAILS=you@example.com                # Comma-separated lowercased allowlist. Set to "*" to disable.
SEED_OWNER_EMAIL=you@example.com              # Email that owns pre-multi-user data. Used by backfill + bearer-token resolver.

# Optional
API_TOKEN=                                    # Long-lived bearer for curl scripts. Resolves to SEED_OWNER_EMAIL's user_id.
TODOIST_API_TOKEN=                            # Seed-owner Todoist fallback. Other users set theirs in /settings.
TODOIST_PROJECT_NAME=Shopping                 # Seed-owner Todoist fallback.

# Image generation & ingest (not part of auth)
#
# AI image generation — two paths, in precedence order:
#
# 1. Connect Replicate via the Vercel marketplace integration.
#    That auto-injects REPLICATE_API_TOKEN into the project, no
#    manual setting needed. The app uses black-forest-labs/flux-schnell
#    by default (~$0.003/image, ~2s).
#
# 2. Generic HTTP fallback. If REPLICATE_API_TOKEN is unset but
#    these two are present, POSTs to IMAGE_GEN_URL with a Bearer
#    token. The endpoint must return either raw image bytes
#    (Content-Type: image/...) or JSON with a { url } field.
#
# With neither configured, the admin Generate buttons show a clear
# "not configured" toast.
REPLICATE_API_TOKEN=                          # Replicate API token (auto-injected via Vercel marketplace)
IMAGE_GEN_URL=                                # Generic HTTP fallback for image generation
IMAGE_GEN_TOKEN=                              # Bearer token for IMAGE_GEN_URL

# Recipe ingestion via claude-agent on nex.
# Mint a token from the dashboard's "API Tokens" tab (scope: chat).
# Without it, /api/ingest returns 503 ingest_disabled.
NEX_API_TOKEN=                                # claude-agent API token for recipe ingestion
CLAUDE_AGENT_URL=https://nex.tail7f6b96.ts.net:10000  # claude-agent base URL (Tailscale Funnel endpoint)
