# Core application
DATABASE_URL=postgres://...                  # Neon pooled connection string
AUTH_SECRET=                                  # openssl rand -base64 32
AUTH_GOOGLE_ID=                               # Google OAuth client ID
AUTH_GOOGLE_SECRET=                           # Google OAuth client secret
AUTH_TRUST_HOST=true                          # Required behind Vercel/custom domains
ALLOWED_EMAILS=you@example.com                # Lowercase CSV; "*" opens sign-up
SEED_OWNER_EMAIL=you@example.com              # Owner for migrated data and bearer requests

# Local-only convenience. Leave AUTH_URL UNSET in Vercel production because
# the app serves both a custom domain and Vercel aliases.
AUTH_URL=http://localhost:3000

# Dish images and Nex-backed recipe/image generation
BLOB_READ_WRITE_TOKEN=                        # Vercel Blob token
NEX_API_TOKEN=                                # Nex token with chat + images:generate scopes
CLAUDE_AGENT_URL=https://nex.tail7f6b96.ts.net:10000  # Optional; this is the default
PREMIUM_IMAGE_EMAILS=                         # Optional CSV; unset = seed owner only, "*" = all

# Optional script/domain-API and Todoist access
API_TOKEN=                                    # Bearer for curl/scripts; resolves to seed owner
TODOIST_API_TOKEN=                            # Seed-owner fallback; users configure their own in Settings
TODOIST_PROJECT_NAME=Shopping                 # Seed-owner fallback

# Optional but recommended for server-side batch-import completion. Without it,
# imports advance only while the /add tab is open. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# Intentionally absent: ADMIN_PASSWORD and SESSION_SECRET are retired.
# GEMINI_API_KEY, REPLICATE_API_TOKEN, IMAGE_GEN_URL, and IMAGE_GEN_TOKEN are
# unused; all image generation goes through Nex.
