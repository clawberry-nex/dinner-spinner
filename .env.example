DATABASE_URL=postgres://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string-at-least-16-chars
API_TOKEN=another-long-random-string-for-the-post-endpoint
TODOIST_API_TOKEN=your-todoist-rest-api-token
TODOIST_PROJECT_NAME=Groceries

# AI image generation — two paths, in precedence order:
#
# 1. Connect Replicate via the Vercel marketplace integration.
#    That auto-injects REPLICATE_API_TOKEN into the project, no
#    manual setting needed. The app uses black-forest-labs/flux-schnell
#    by default (~$0.003/image, ~2s).
#
# 2. Generic HTTP fallback. If REPLICATE_API_TOKEN is unset but
#    these two are present, POSTs to IMAGE_GEN_URL with a Bearer
#    token. The endpoint must return either raw image bytes
#    (Content-Type: image/...) or JSON with a { url } field.
#
# With neither configured, the admin Generate buttons show a clear
# "not configured" toast.
REPLICATE_API_TOKEN=
IMAGE_GEN_URL=
IMAGE_GEN_TOKEN=

# BLOB_READ_WRITE_TOKEN is auto-injected when the Vercel Blob store
# is added to the project — no manual setting needed in production.
# In local dev, pull it with `vercel env pull .env.local`.

# Recipe ingestion via claude-agent on nex.
# Mint a token from the dashboard's "API Tokens" tab (scope: chat).
# Without it, /api/ingest returns 503 ingest_disabled.
NEX_API_TOKEN=
# Optional override for the claude-agent base URL. Defaults to the
# Tailscale Funnel endpoint (off-tailnet). Override for local dev when
# running claude-agent on a different host.
CLAUDE_AGENT_URL=https://nex.tail7f6b96.ts.net:10000
